---
import Icon from './Icon.astro';
import { PROGRAMS, rupiah } from '@domain/content';
interface Props { showSdBadge?: boolean }
const { showSdBadge = false } = Astro.props;
---
<section id="biaya" class="container section reveal">
  <div class="sec-head center">
    <span class="eyebrow">JENJANG &amp; BIAYA</span>
    <h2 class="h2">Biaya Belajar yang Sederhana</h2>
    <p class="lead">Satu harga per bulan, tanpa paket yang membingungkan.</p>
  </div>
  <div class="grid-auto cards" style="--min:340px;gap:24px">
    {PROGRAMS.map((p) => {
      const tk = p.level === 'TK';
      return (
        <div class:list={['plan', tk ? 'tk' : 'sd', { featured: !tk && showSdBadge }]}>
          {!tk && showSdBadge && <span class="badge">PALING BANYAK DIPILIH</span>}
          <div class="top"><span class="lvl">{p.level}</span><span class="tag">{p.tag}</span></div>
          <p class="desc">{p.desc}</p>
          <div class="price">
            <div class="promo"><span class="promo-pill">PROMO</span><s>{rupiah(p.normalPrice)}</s></div>
            <div class="amount"><b>{rupiah(p.promoPrice)}</b><span>/bulan</span></div>
          </div>
          <hr />
          <ul>{p.features.map((f) => <li class="check"><Icon name="check" size={20} width={2.4} />{f}</li>)}</ul>
          <button class:list={['btn', tk ? 'btn-dark' : 'btn-primary']} data-open-modal data-level={p.level}>Daftar {p.level}</button>
        </div>
      );
    })}
  </div>
</section>

<style>
  .cards { max-width: 960px; margin-inline: auto; }
  .plan { position: relative; border-radius: var(--r-lg); padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 20px; }
  .tk { background: #FFF5EB; border: 1px solid #F8E3D3; --c: var(--peach-dark); --hr: #F3DCCB; }
  .sd { background: #EDF2FF; border: 1px solid #D6E0F7; --c: var(--primary-dark); --hr: #D6E0F7; }
  .featured { border: 2px solid var(--primary); }
  .badge { position: absolute; top: -13px; right: 28px; padding: 5px 12px; border-radius: 999px; background: var(--primary); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .1em; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .lvl { font-size: 30px; font-weight: 900; color: var(--c); }
  .tag { padding: 5px 12px; border-radius: 999px; background: #fff; font-size: 13px; font-weight: 700; color: var(--text-sec); }
  .desc { color: var(--text-2); font-size: 17px; }
  .price { display: flex; flex-direction: column; gap: 8px; }
  .promo { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .promo-pill { padding: 4px 10px; border-radius: 999px; background: var(--c); color: #fff; font-size: 12px; font-weight: 800; letter-spacing: .08em; }
  .promo s { color: var(--text-muted); font-weight: 700; font-size: 18px; }
  .amount { display: flex; align-items: baseline; gap: 6px; }
  .amount b { font-size: clamp(38px, 4.4vw, 48px); font-weight: 900; letter-spacing: -.02em; line-height: 1; }
  .amount span { color: var(--text-sec); font-weight: 700; }
  hr { border: 0; height: 1px; background: var(--hr); margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  li svg { stroke: var(--c); }
  .btn { margin-top: auto; height: 52px; }
</style>
