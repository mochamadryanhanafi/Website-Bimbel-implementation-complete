---
import Icon from './Icon.astro';
import { WA_ASK } from '@infra/whatsapp';
interface Props { sticky?: boolean }
const { sticky = true } = Astro.props;
---
<a href={WA_ASK} target="_blank" aria-label="Chat WhatsApp" class="fab"><Icon name="wa" size={28} /></a>
{sticky && (
  <div class="sticky" data-sticky>
    <a href={WA_ASK} target="_blank" class="btn btn-wa">WhatsApp Admin</a>
    <button class="btn btn-primary" data-open-modal>Daftar</button>
  </div>
)}

<style>
  .fab { position: fixed; right: 24px; bottom: 24px; z-index: 40; width: 58px; height: 58px; border-radius: 50%; background: var(--wa); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(37,211,102,.35); transition: transform .18s; }
  .fab:hover { transform: translateY(-2px); color: #fff; }
  .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.95); backdrop-filter: blur(14px); border-top: 1px solid var(--border-2); display: none; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sticky .btn { height: 50px; }
  @media (max-width: 767px) {
    .fab { right: 18px; bottom: 18px; }
    body.scrolled .sticky { display: grid; }
    body.scrolled .fab { display: none; }
  }
</style>

<script>
  addEventListener('scroll', () => document.body.classList.toggle('scrolled', scrollY > 560), { passive: true });
</script>
