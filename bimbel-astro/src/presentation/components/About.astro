---
import Icon from './Icon.astro';
const points = ['Pendampingan personal', 'Jadwal teratur', 'Sesuai materi sekolah', 'Komunikasi dengan orang tua'];
---
<section id="tentang" class="container section reveal">
  <div class="wrap">
    <div class="photo"><img src="/images/section.png" alt="Anak TK dan SD belajar bersama dengan balok dan buku" loading="lazy" /></div>
    <div class="sec-head" style="margin:0;gap:18px">
      <span class="eyebrow">TENTANG KAMI</span>
      <h2 class="h2">Pendampingan Belajar yang Lebih Dekat</h2>
      <p class="lead">Kami membantu anak belajar dengan suasana yang nyaman, sabar, dan terarah — sehingga anak tidak hanya mengerjakan tugas, tetapi juga memahami pelajarannya.</p>
      <div class="points">
        {points.map((p) => <div class="check pt"><Icon name="check" size={20} width={2.4} stroke="var(--green-dark)" />{p}</div>)}
      </div>
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .photo { aspect-ratio: 4/3; border-radius: var(--r-lg); overflow: hidden; background: #fff; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .points { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .pt { padding: 12px 14px; border-radius: var(--r-sm); background: var(--surface-soft); font-weight: 700; }
</style>
