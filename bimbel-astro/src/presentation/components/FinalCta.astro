---
import Icon from './Icon.astro';
import { WA_ASK } from '@infra/whatsapp';
---
<section class="container reveal" style="padding-block:clamp(16px,3vw,32px)">
  <div class="box">
    <div class="blob b1"></div><div class="blob b2"></div>
    <div class="text">
      <h2 class="h2" style="font-size:clamp(18px,2.2vw,24px);text-wrap:balance">Siap Membantu Anak Belajar Lebih Nyaman?</h2>
      <p style="color:var(--text-2);font-size:14px">Konsultasikan kebutuhan belajar anak dengan admin.</p>
    </div>
    <div class="actions">
      <button class="btn btn-primary" data-open-modal>Daftarkan Anak</button>
      <a href={WA_ASK} target="_blank" class="btn btn-wa"><Icon name="wa" size={20} />Chat WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .box { position: relative; overflow: hidden; background: var(--primary-soft); border-radius: var(--r-xl); padding: clamp(18px, 3vw, 28px) clamp(18px, 3vw, 36px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; }
  .box > * { position: relative; }
  .text { display: flex; flex-direction: column; gap: 4px; flex: 1 1 320px; }
  .blob { position: absolute; border-radius: 50%; filter: blur(40px); }
  .b1 { width: 220px; height: 220px; background: var(--peach); opacity: .16; top: -60px; left: -40px; }
  .b2 { width: 200px; height: 200px; background: var(--yellow); opacity: .25; bottom: -70px; right: -30px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
