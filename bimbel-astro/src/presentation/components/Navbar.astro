---
import Icon from './Icon.astro';
import { BRAND, NAV } from '@domain/content';
import { WA_ASK } from '@infra/whatsapp';
---
<header class="nav">
  <div class="container bar">
    <a href="#beranda" class="brand">
      <span class="logo"><Icon name="book" /></span>
      <span class="brand-text"><b>{BRAND.name}</b><small>{BRAND.tagline}</small></span>
    </a>
    <div class="desk">
      <nav>
        <a href="#beranda" class="active">Beranda</a>
        {NAV.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <button class="btn btn-primary cta" data-open-modal>Daftar Sekarang</button>
    </div>
    <button class="burger" aria-label="Menu" aria-expanded="false" data-menu-toggle><Icon name="menu" /></button>
  </div>
  <div class="mobile" hidden data-menu>
    {NAV.map(([href, label]) => <a href={href} data-menu-close>{label}</a>)}
    <div class="mobile-cta">
      <a href={WA_ASK} target="_blank" class="btn btn-wa">WhatsApp</a>
      <button class="btn btn-primary" data-open-modal>Daftar Sekarang</button>
    </div>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; height: var(--nav-h); background: rgba(255,255,255,.9); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border-2); }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--text); }
  .logo { width: 42px; height: 42px; border-radius: var(--r-sm); background: var(--primary); display: grid; place-items: center; color: #fff; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text b { font-weight: 800; font-size: 17px; }
  .brand-text small { font-weight: 700; font-size: 12px; color: var(--text-sec); letter-spacing: .04em; }
  .desk { display: none; align-items: center; gap: clamp(20px, 3vw, 40px); }
  nav { display: flex; gap: 28px; font-weight: 700; font-size: 15px; }
  nav a { color: var(--text-sec); }
  nav a:hover, nav a.active { color: var(--text); }
  nav a.active { color: var(--primary-dark); }
  .cta { height: 46px; padding: 0 22px; font-size: 15px; }
  .burger { width: 46px; height: 46px; border-radius: var(--r-sm); border: 1px solid var(--border); background: #fff; display: grid; place-items: center; color: var(--text); cursor: pointer; }
  .mobile { position: absolute; top: var(--nav-h); left: 0; right: 0; background: #fff; border-bottom: 1px solid var(--border-2); box-shadow: var(--sh-lg); padding: 12px 20px 20px; display: flex; flex-direction: column; gap: 4px; font-weight: 700; }
  .mobile[hidden] { display: none; }
  .mobile > a { padding: 12px 4px; color: var(--text); }
  .mobile-cta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
  .mobile-cta .btn { height: 50px; }
  @media (min-width: 768px) { .desk { display: flex; } .burger, .mobile { display: none; } }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const set = (open: boolean) => { menu.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); };
  toggle.addEventListener('click', () => set(menu.hidden));
  menu.querySelectorAll('[data-menu-close], [data-open-modal]').forEach((a) => a.addEventListener('click', () => set(false)));
</script>
