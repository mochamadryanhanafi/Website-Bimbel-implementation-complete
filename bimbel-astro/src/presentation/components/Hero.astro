---
import Icon from './Icon.astro';
import { PROGRAMS, rupiah } from '@domain/content';
import { WA_ASK } from '@infra/whatsapp';
---
<section id="beranda" class="hero">
  <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
  <div class="container inner">
    <div class="copy">
      <span class="pill">BIMBINGAN BELAJAR TK &amp; SD</span>
      <h1>Belajar Lebih Nyaman, <span>Anak Lebih Percaya Diri</span></h1>
      <p class="lead">Pendampingan belajar untuk membantu anak memahami pelajaran sekolah dengan suasana yang ramah, terarah, dan menyenangkan.</p>
      <div class="prices">
        {PROGRAMS.map((p) => (
          <span class={`price tone-${p.level === 'TK' ? 'peach' : 'primary'}`}>
            <Icon name="check" size={18} width={2.4} />
            <span>{p.level} <s>{rupiah(p.normalPrice)}</s> {rupiah(p.promoPrice)}<em>/bln</em></span>
          </span>
        ))}
      </div>
      <div class="actions">
        <button class="btn btn-primary" data-open-modal>Daftarkan Anak</button>
        <a href={WA_ASK} target="_blank" class="btn btn-outline"><Icon name="wa" size={20} />Tanya via WhatsApp</a>
      </div>
    </div>
    <div class="visual">
      <div class="frame"><img src="/images/hero.png" alt="Dua siswi SD tersenyum mengerjakan soal matematika" loading="eager" /></div>
      <div class="float">
        <span class="icon-box tone-yellow"><Icon name="calendar" size={20} /></span>
        <span><b>Kamis – Minggu</b><small>2 pilihan sesi</small></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #F6F8FF, #FFF9F4); }
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); }
  .b1 { width: 420px; height: 420px; background: var(--primary-muted); opacity: .28; top: -140px; right: 8%; }
  .b2 { width: 300px; height: 300px; background: var(--peach); opacity: .18; bottom: -120px; left: -60px; }
  .b3 { width: 200px; height: 200px; background: var(--yellow); opacity: .22; bottom: 40px; right: -40px; filter: blur(50px); }
  .inner { position: relative; padding-block: clamp(48px, 7vw, 88px) clamp(56px, 8vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(36px, 5vw, 64px); align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .pill { padding: 7px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--border); color: var(--primary-dark); font-weight: 800; font-size: 12px; letter-spacing: .12em; }
  h1 { font-size: clamp(36px, 5vw, 54px); line-height: 1.1; font-weight: 800; letter-spacing: -.02em; text-wrap: balance; }
  h1 span { color: var(--primary-dark); }
  .lead { font-size: clamp(16px, 1.6vw, 18px); max-width: 500px; text-wrap: pretty; }
  .prices { display: flex; flex-wrap: wrap; gap: 10px; }
  .price { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 15px; color: var(--text); }
  .price s { color: var(--text-muted); font-weight: 600; }
  .price em { font-style: normal; color: var(--text-sec); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; width: 100%; }
  .actions .btn { flex: 1 1 200px; max-width: 240px; }
  .btn-primary { box-shadow: 0 8px 24px rgba(111,143,216,.35); }
  .visual { position: relative; aspect-ratio: 5/4; width: 100%; }
  .frame { position: absolute; inset: 0; border-radius: var(--r-xl); overflow: hidden; background: rgba(255,255,255,.35); border: 1px solid rgba(255,255,255,.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 20px 50px rgba(40,60,100,.12); }
  .frame img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  .float { position: absolute; left: -14px; bottom: 24px; background: #fff; border-radius: 12px; padding: 12px 16px; box-shadow: 0 8px 30px rgba(40,60,100,.10); display: flex; align-items: center; gap: 12px; pointer-events: none; }
  .float .icon-box { width: 40px; height: 40px; border-radius: 8px; }
  .float > span:last-child { display: flex; flex-direction: column; line-height: 1.25; }
  .float b { font-weight: 800; font-size: 15px; }
  .float small { font-size: 13px; color: var(--text-sec); font-weight: 600; }
</style>
